# ─────────────────────────────────────────────────────────────
# iubip-retake-bot — боевой контур (образ, профиль prod)
# Скопируй в .env рядом с docker-compose.yml и заполни значения.
# Compose читает .env для ПОДСТАНОВКИ переменных в docker-compose.yml.
# ─────────────────────────────────────────────────────────────

# ── База и Redis (внутри compose: db / redis) ───────────────
DB_USER=iubip
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=iubip_retake

# ── MAX: в бою MOCK_MAX=false, токен обязателен ──────────────
MAX_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
MAX_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
MAX_BOT_NAME=iubip-retake-bot

# ── Внутренний API: заголовок X-Service-Token ────────────────
SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN

# ── Платёжный сервис (iubip-sbp-pay) ─────────────────────────
# В Docker Desktop адрес хоста — host.docker.internal
PAYMENT_API_BASE=http://host.docker.internal:3200
PAYMENT_API_TOKEN=CHANGE_ME

# ── Прочее ───────────────────────────────────────────────────
LOG_LEVEL=info
DIRECTORATE_CHAT_ID=3001
CANCEL_DEADLINE_HOURS=0
REMINDERS_ENABLED=false
