# ─────────────────────────────────────────────────────────────
# iubip-retake-bot — пример окружения
# Скопируй в .env и поправь под себя: cp .env.example .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://iubip:iubip@db:5432/iubip_retake
REDIS_URL=redis://redis:6379

# ── MAX: главный переключатель MVP ────────────────────────────
# true по умолчанию — проект работает БЕЗ токена MAX (mock-клиент + веб-эмулятор).
# При MOCK_MAX=false MAX_BOT_TOKEN обязателен, иначе приложение падает при старте.
MOCK_MAX=true
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=
MAX_BOT_NAME=

# ── Сервис оплаты (существующий сайт iubip-sbp-pay) ──────────
PAYMENT_API_BASE=http://host.docker.internal:3200
PAYMENT_API_TOKEN=dev-secret

# ── Внутренний API (X-Service-Token) ──────────────────────────
SERVICE_TOKEN=dev-service-token

# ── Бизнес-правила ───────────────────────────────────────────
# 0 = отмена записи студентом без ограничения по времени (дефолт MVP)
CANCEL_DEADLINE_HOURS=0
DEFAULT_ALERT_THRESHOLD=30
TOKEN_TTL_HOURS=72

# ── Файлы (чеки) ─────────────────────────────────────────────
FILES_DIR=/data/receipts
FILES_MAX_BYTES=10485760

# ── Дирекция ─────────────────────────────────────────────────
DIRECTORATE_CHAT_ID=dev-directorate

# ── Отложенные фичи ──────────────────────────────────────────
REMINDERS_ENABLED=false
