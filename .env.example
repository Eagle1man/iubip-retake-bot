# ─────────────────────────────────────────────────────────────
# iubip-retake-bot — пример окружения
# Скопируй в .env и поправь под себя: cp .env.example .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Значения для локального запуска (путь B в README).
# В docker-compose.yml свои значения: db / redis как имена сервисов.
DATABASE_URL=postgresql://iubip:iubip@localhost:5432/iubip_retake
DATABASE_URL_TEST=postgresql://iubip:iubip@localhost:5432/iubip_retake_test
REDIS_URL=redis://localhost:6379

# ── MAX: главный переключатель MVP ────────────────────────────
# true по умолчанию — проект работает БЕЗ токена MAX (mock-клиент + веб-эмулятор).
# При MOCK_MAX=false MAX_BOT_TOKEN обязателен, иначе приложение падает при старте.
MOCK_MAX=true
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=
MAX_BOT_NAME=

# Транспорт входящих событий MAX (расширенное ТЗ §3, §7):
# webhook — production (этап 2); polling — long polling (этап 1.5, ручная проверка).
# Взаимоисключение: при webhook поллер не запускается, при polling вебхук
# /internal/webhook/max отвечает 404. POLLING требует MAX_BOT_TOKEN.
MODE=webhook

# ── Сервис оплаты (существующий сайт iubip-sbp-pay) ──────────
# В Docker Desktop адрес хоста — host.docker.internal, локально localhost.
PAYMENT_API_BASE=http://localhost:3200
PAYMENT_API_TOKEN=dev-secret

# ── Внутренний API (X-Service-Token) ──────────────────────────
SERVICE_TOKEN=dev-service-token

# ── Бизнес-правила ───────────────────────────────────────────
# 0 = отмена записи студентом без ограничения по времени (дефолт MVP)
CANCEL_DEADLINE_HOURS=0
DEFAULT_ALERT_THRESHOLD=30
TOKEN_TTL_HOURS=72

# ── Файлы (чеки) ─────────────────────────────────────────────
# Локально (Mac/Linux/Windows) — ./data: создание /data/receipts требует root.
# В контейнере docker-compose задаёт своё значение (/data/receipts).
FILES_DIR=./data
FILES_MAX_BYTES=10485760

# ── Дирекция ─────────────────────────────────────────────────
# 3001 — пресет «Дирекция (3001)» в эмуляторе /mock/
DIRECTORATE_CHAT_ID=3001

# ── Отложенные фичи ──────────────────────────────────────────
# Напоминание за REMINDER_LEAD_HOURS до начала сессии (ТЗ: 24 ч, окно ±5 мин).
# При false планировщик ничего не ставит в очередь.
REMINDERS_ENABLED=false
REMINDER_LEAD_HOURS=24
